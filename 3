// Model Functions
function add_user($conn, $firstName, $lastName, $street, $city, $state, $zip) {
    $addQuery = "INSERT INTO
        userinfo (FirstName, LastName, Street, City, State, ZipCode)
        VALUES ('$firstName', '$lastName', '$street', '$city', '$state', '$zip')";
    return mysqli_query($conn, $addQuery);
}

function get_user($conn, $addressNo) {
    $selQuery = "SELECT * FROM userinfo WHERE AddressNo = $addressNo";
    $result = mysqli_query($conn, $selQuery);
    return mysqli_fetch_assoc($result);
}

function update_user($conn, $addressNo, $firstName, $lastName, $street, $city, $state, $zip) {
    $updQuery = "UPDATE userinfo SET
        FirstName = '$firstName', LastName = '$lastName',
        Street = '$street', City = '$city',
        State = '$state', ZipCode = '$zip'
        WHERE AddressNo = $addressNo";
    return mysqli_query($conn, $updQuery);
}

function delete_user($conn, $addressNo) {
    $delQuery = "DELETE FROM userinfo WHERE AddressNo = $addressNo";
    return mysqli_query($conn, $delQuery);
}

function get_all_users($conn) {
    $query = "SELECT * FROM userinfo";
    return mysqli_query($conn, $query);
}
