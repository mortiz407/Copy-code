require_once('model.php');

// Establish variables to support add/edit/delete
$addressNo = -1;
$firstName = "";
$lastName = "";
$street = "";
$city = "";
$state = "";
$zip = "";

// Variables to determine the type of operation
$add = false;
$edit = false;
$update = false;
$delete = false;

if (isset($_POST['address_no'])) {
    $addressNo = $_POST['address_no'];
    $add = isset($_POST['add']);
    $update = isset($_POST['update']);
    $edit = isset($_POST['edit']);
    $delete = isset($_POST['delete']);
}

if ($add) {
    // Need to add a new user
    $firstName = $_POST['first_name'];
    $lastName = $_POST['last_name'];
    $street = $_POST['street_name'];
    $city = $_POST['city'];
    $state = $_POST['state'];
    $zip = $_POST['zip_code'];

    add_user($conn, $firstName, $lastName, $street, $city, $state, $zip);

    // Clear the fields
    $addressNo = -1;
    $firstName = "";
    $lastName = "";
    $street = "";
    $city = "";
    $state = "";
    $zip = "";
}
else if ($edit) {
    // Get the user information
    $userInfo = get_user($conn, $addressNo);

    // Fill in the values to allow edit
    $firstName = $userInfo['FirstName'];
    $lastName = $userInfo['LastName'];
    $street = $userInfo['Street'];
    $city = $userInfo['City'];
    $state = $userInfo['State'];
    $zip = $userInfo['ZipCode'];
}
else if ($update) {
    // Update values submitted
    $firstName = $_POST['first_name'];
    $lastName = $_POST['last_name'];
    $street = $_POST['street_name'];
    $city = $_POST['city'];
    $state = $_POST['state'];
    $zip = $_POST['zip_code'];

    update_user($conn, $addressNo, $firstName, $lastName, $street, $city, $state, $zip);

    // Clear the fields
    $addressNo = -1;
    $firstName = "";
    $lastName = "";
    $street = "";
    $city = "";
    $state = "";
    $zip = "";
}
else if ($delete) {
    // Need to delete the selected user
    delete_user($conn, $addressNo);
    $addressNo = -1;
}

// Query for all users to display in the table
$result = get_all_users($conn);

// Load View
