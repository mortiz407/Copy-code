package com.example.contactsmobileapp

import android.content.Intent
import androidx.appcompat.app.AppCompatActivity
import android.os.Bundle
import android.widget.Button

//Manuel Ortiz
//Manuel Ortiz - Contacts Address Book
//11/15/2026
class MainActivity : AppCompatActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_main)

        val manuelButton = findViewById<Button>(R.id.btnContact1)
        manuelButton.setOnClickListener {
            startActivity(Intent(this, ManuelApple::class.java))
        }

        val siwarButton = findViewById<Button>(R.id.btnContact2)
        siwarButton.setOnClickListener {
            startActivity(Intent(this, SiwarApple::class.java))
        }
    }
}


