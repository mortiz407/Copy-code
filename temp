<resources>
    <string name="app_name">Manuel Ortiz - Temperature Conversion</string>
    <string name="txt_title">Temperature Converter</string>
    <string name="hint_temp">Enter Temperature</string>
    <string name="rad_f_to_c">Fahrenheit (°F) to Celsius (°C)</string>
    <string name="rad_c_to_f">Celsius (°C) to Fahrenheit (°F)</string>
    <string name="btn_convert">Convert Temperature</string>
    <string name="img_desc">Thermometer graphic</string>
</resources>





<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.PATemperatureConversion" parent="Theme.Material3.DayNight">
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.PATemperatureConversion" parent="Base.Theme.PATemperatureConversion" />
