<?php
require_once('database.php');

function get_all_records()
{
    $conn = get_db_conn();
    $query = "SELECT * FROM catalog";
    return mysqli_query($conn, $query);
}

function get_record_by_id($productId)
{
    $conn = get_db_conn();
    $query = "SELECT * FROM catalog WHERE ProductID = $productId";
    $result = mysqli_query($conn, $query);
    return mysqli_fetch_assoc($result);
}

function add_record($productName, $productCost, $productDescription)
{
    $conn = get_db_conn();
    $query = "INSERT INTO catalog (ProductName, ProductCost, ProductDescription)
              VALUES ('$productName', '$productCost', '$productDescription')";
    return mysqli_query($conn, $query);
}

function update_record($productId, $productName, $productCost, $productDescription)
{
    $conn = get_db_conn();
    $query = "UPDATE catalog SET
              ProductName = '$productName',
              ProductCost = '$productCost',
              ProductDescription = '$productDescription'
              WHERE ProductID = $productId";
    return mysqli_query($conn, $query);
}

function delete_record($productId)
{
    $conn = get_db_conn();
    $query = "DELETE FROM catalog WHERE ProductID = $productId";
    return mysqli_query($conn, $query);
}
?>




